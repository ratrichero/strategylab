# Database
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# Telegram
TELEGRAM_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# API Authentication
# Format: "name:key,name2:key2"
API_KEYS=dashboard:dash_key_here,bot:bot_key_here
# API_KEY=single_key_fallback

# Rate Limiting
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW=60

# Trading Mode: PAPER / TESTNET / LIVE
TRADING_MODE=PAPER

# Binance Live (chỉ dùng khi LIVE)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Binance Testnet (chỉ dùng khi TESTNET)
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=

# AI/LLM
GROQ_API_KEY=your_groq_key
GEMINI_API_KEY=your_gemini_key

# CORS (frontend origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Engine URL (internal)
ENGINE_URL=http://localhost:8000

# ============================================================
# LIVE TRADING CONFIG
# ============================================================
# Position sizing
RISK_PER_TRADE_PCT=0.01
DEFAULT_LEVERAGE=3
MAX_POSITION_USDT=500
