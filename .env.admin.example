# ============================================================
# ADMIN MODE - Control Plane + Admin Bot Trading
# ============================================================

APP_ROLE=ADMIN

# Required: admin DB contains control-plane tables and admin trading data.
DATABASE_URL=postgresql://user:password@host:5432/admin_db

# Required for encrypted bot DB URLs in admin DB.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_MASTER_KEY=

# Required for dashboard login cookie JWT.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=24

# Keep false unless you intentionally manage migrations outside app startup.
SKIP_AUTH_MIGRATION=false
SKIP_CONTROL_MIGRATION=false

# Telegram is needed at server startup for polling bot and notifications.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Binance and LLM credentials are configured in Settings after login.

# HTTP/Auth hardening.
# Use the exact frontend origin in production, for example: https://dashboard.example.com
CORS_ORIGINS=
COOKIE_SECURE=true
EXPOSE_API_DOCS=false

# Price feed is env-driven.
PRICE_FEED_MODE=AUTO
HTTP_PRICE_SOURCE=MARK
PRICE_FEED_HTTP_INTERVAL=1.5
PRICE_FEED_WS_RECOVERY_INTERVAL=60

# Optional fallback only. Normal trading mode is stored in app_config via Settings.
# TRADING_MODE=PAPER

# Optional fallback only. Prefer configuring LLM keys in Settings after login.
# GROQ_API_KEY=
# GEMINI_API_KEY=

# Frontend build-time only. Do not put these in backend runtime env unless needed.
# VITE_API_BASE=
# VITE_API_KEY=

# Volatility alerts are configured via VOL_ALERT_CONFIG in Settings.
# Env VOL_ALERT_* keys are only fallback defaults and are intentionally omitted here.

# Not needed in ADMIN mode:
# BOT_ID
# BOT_SECRET
# ADMIN_ENDPOINTS
# BOOTSTRAP_CACHE_PATH
# RATE_LIMIT_REQUESTS
# RATE_LIMIT_WINDOW
