# ============================================================
# BOT MODE - User Bot Runtime
# ============================================================

APP_ROLE=BOT

# Required: bot identity issued by the admin control plane.
BOT_ID=
BOT_SECRET=

# Required: comma-separated admin control-plane endpoints.
# Example: https://control.example.com,https://control-backup.example.com
ADMIN_ENDPOINTS=https://control.example.com

# Required/recommended: encrypted local fallback cache.
# Must be writable by the bot process. Keep this file private.
BOOTSTRAP_CACHE_PATH=/app/data/bootstrap.enc

# Required: dashboard login cookie JWT for this bot dashboard.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=24

# Keep false unless you intentionally manage auth migration outside app startup.
SKIP_AUTH_MIGRATION=false

# Optional: Telegram is ENV-only. If blank, Telegram polling/notifications are disabled.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# HTTP/Auth hardening.
# Use the exact bot dashboard origin in production, for example: https://bot-001.example.com
CORS_ORIGINS=https://your-bot-dashboard-domain.com
COOKIE_SECURE=true
EXPOSE_API_DOCS=false

# Price feed is env-driven.
PRICE_FEED_MODE=AUTO
HTTP_PRICE_SOURCE=MARK
PRICE_FEED_HTTP_INTERVAL=1.5
PRICE_FEED_WS_RECOVERY_INTERVAL=60

# Configured after login in Settings / bot DB:
# BINANCE_API_KEY
# BINANCE_API_SECRET
# BINANCE_TESTNET_API_KEY
# BINANCE_TESTNET_API_SECRET
# GROQ_API_KEY
# GEMINI_API_KEY
# TRADING_MODE
# VOL_ALERT_CONFIG

# Not needed in BOT mode:
# DATABASE_URL          (received from admin activate API or encrypted cache)
# SKIP_CONTROL_MIGRATION